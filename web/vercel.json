{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "ui-screens-output": false
    }
  },
  "rewrites": [
    {
      "source": "/b/:shop/manifest.webmanifest",
      "destination": "https://wxggsackpbqyixkznpez.supabase.co/functions/v1/app-icon?b=:shop&f=manifest"
    },
    {
      "source": "/b/:shop/icon.png",
      "destination": "https://wxggsackpbqyixkznpez.supabase.co/functions/v1/app-icon?b=:shop&f=png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
